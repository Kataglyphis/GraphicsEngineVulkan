# Frozen 2026-09-15, the pass that turned `run-lint-gates.sh --ratchets` on.
# Shell functions the scanner sees no caller for. Two-way: a frozen function
# that gains a caller in the corpus, or is deleted, is STALE.
# Each group names the dispatch the scanner cannot see. Format: <file>\t<function>.
# third_party/ANTfrastructure/docs/code-quality-tooling.md#dead-shell-functions-dead-functions

# HOOKS DISPATCHED BY NAME FROM ANTfrastructure, which is outside the corpus.
# The libraries probe with `declare -F <name>` and call it if it exists, so the
# only textual mention is in the hub:
#   linux/scripts/lib/cmake-build.sh:311  cmake_build_prebuild_hook
#   linux/scripts/lib/app-runner.sh:191   app_runner_post_vulkan_hook
#   linux/scripts/lib/app-runner.sh:201   app_runner_env_hook
# Deleting one silently drops a build or launch step with nothing to fail.
scripts/linux/cmake-configure-build.sh	cmake_build_prebuild_hook
scripts/linux/run-riscv64-tests.sh	cmake_build_prebuild_hook
scripts/linux/run-debug.sh	app_runner_env_hook
scripts/linux/run-debug.sh	app_runner_post_vulkan_hook
scripts/linux/run-release.sh	app_runner_env_hook

# scripts/linux/lib/common.sh's two path helpers. The hub's lib/app-runner.sh:80
# calls get_project_root through `declare -F`, like the hooks above; get_script_root
# has no caller and stays frozen until it gains one or is deleted. get_build_jobs
# went on 2026-10-19: without it the hub's cmake-build.sh takes the same
# compute_jobs_with_mem_cap value from parallelism.sh.
scripts/linux/lib/common.sh	get_project_root
scripts/linux/lib/common.sh	get_script_root
